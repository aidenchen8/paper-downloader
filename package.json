{
  "name": "paper-downloader",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome-first paper downloader skill powered by Playwright",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "download": "node ./scripts/run-paper-downloader.mjs",
